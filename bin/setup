#!/usr/bin/env bash
#
# setup — Idempotent environment setup for campaign repository.
#
set -e

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# Expand standard paths without overriding active version managers (chruby, rbenv, asdf, mise)
EXTRA_PATH="$HOME/.local/bin"
for ruby_bin in "$HOME"/.rubies/*/bin; do
  [ -d "$ruby_bin" ] && EXTRA_PATH="$EXTRA_PATH:$ruby_bin"
done
for gem_bin in "$HOME"/.gem/ruby/*/bin "$HOME"/.local/share/gem/ruby/*/bin; do
  [ -d "$gem_bin" ] && EXTRA_PATH="$EXTRA_PATH:$gem_bin"
done
export PATH="$PATH:$EXTRA_PATH:$HOME/.rbenv/shims:$HOME/.asdf/shims:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin"
export LC_ALL="${LC_ALL:-en_GB.UTF-8}"
export LANG="${LANG:-en_GB.UTF-8}"

echo "==> Setting up campaign environment in $REPO_ROOT..."

# 1. Configure Git hooks
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git config core.hooksPath .githooks 2>/dev/null || true
  [ -f .githooks/pre-commit ] && chmod +x .githooks/pre-commit
  echo "  ✓ Configured Git hooks (.githooks/pre-commit)"
fi

# 2. Ensure Ruby gems are installed
BUNDLE_BIN=""
if command -v bundle >/dev/null 2>&1; then
  BUNDLE_BIN="bundle"
elif command -v bundle3.3 >/dev/null 2>&1; then
  BUNDLE_BIN="bundle3.3"
fi

if [ -z "$BUNDLE_BIN" ]; then
  echo "  ✗ Bundler not found in PATH."
  exit 1
fi

"$BUNDLE_BIN" check || "$BUNDLE_BIN" install

# 3. Compile Jekyll site and refresh Tier 1 catalogue
"$BUNDLE_BIN" exec jekyll build

# 4. Check for oude CLI installation
if command -v oude >/dev/null 2>&1; then
  oude doctor
else
  echo "  ⚠ Warning: oude CLI not found in PATH. Install via uv tool install."
fi

echo "==> Setup complete! Your campaign environment is ready."
