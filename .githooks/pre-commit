#!/usr/bin/env sh
# Refresh Tier 1 semantic catalogue upon commit when Markdown content changes.

# 1. Expand standard PATH without overriding active version managers (chruby, rbenv, asdf, mise)
EXTRA_PATH="$HOME/.local/bin"
for ruby_bin in "$HOME"/.rubies/*/bin; do
  [ -d "$ruby_bin" ] && EXTRA_PATH="$EXTRA_PATH:$ruby_bin"
done
for gem_bin in "$HOME"/.gem/ruby/*/bin "$HOME"/.local/share/gem/ruby/*/bin; do
  [ -d "$gem_bin" ] && EXTRA_PATH="$EXTRA_PATH:$gem_bin"
done
export PATH="$PATH:$EXTRA_PATH:$HOME/.rbenv/shims:$HOME/.asdf/shims:$HOME/.local/share/mise/shims:/opt/homebrew/bin:/usr/local/bin"
export LC_ALL="${LC_ALL:-en_GB.UTF-8}"
export LANG="${LANG:-en_GB.UTF-8}"

# 2. Re-index Tier 1 catalogue via Jekyll (oude-mechanismen gem) when Markdown content files are staged
if git diff --cached --name-only 2>/dev/null | grep -q '\.md$'; then
  BUNDLE_BIN=""
  if command -v bundle >/dev/null 2>&1; then
    BUNDLE_BIN="bundle"
  elif command -v bundle3.3 >/dev/null 2>&1; then
    BUNDLE_BIN="bundle3.3"
  fi

  if [ -n "$BUNDLE_BIN" ] && [ -f Gemfile ]; then
    if "$BUNDLE_BIN" exec jekyll build >/dev/null 2>&1; then
      if [ -f .agents/context/catalog.json ]; then
        git add .agents/context/catalog.json 2>/dev/null || true
      fi
    else
      echo "[WARN] 'bundle exec jekyll build' failed; catalog.json may be stale." >&2
    fi
  else
    echo "[WARN] Bundler not found to update catalog.json; commit proceeding." >&2
  fi
fi

# 3. Execute optional local campaign pre-commit hook if present
if [ -x .githooks/pre-commit.local ]; then
  .githooks/pre-commit.local
fi
